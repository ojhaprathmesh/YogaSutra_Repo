# YogaSutra Environment Configuration
# Copy this file to .env and fill in your values

# Google AI API Key (required)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Model configuration (Phase 1 defaults)
YOGASUTRA_MODEL=gemini-2.0-flash

# Tracing
YOGASUTRA_TRACE_DIR=data/traces
YOGASUTRA_LOG_LEVEL=INFO

# Phase 2+ (not required for Phase 1)
# DATABASE_URL=postgresql://user:password@localhost:5432/yogasutra
# PGVECTOR_COLLECTION=yoga_knowledge
