# ==============================================================================
# YogaSutra Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your respective API keys:
#     cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider Keys
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key (Required for primary ADK agent planning)
# Obtain from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# NVIDIA NIM API Key (Optional: for Llama-3.3-70B and fast multi-model fallbacks)
# Obtain from: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Ollama Local Engine (Optional: local host or remote Ollama endpoint)
# e.g., http://localhost:11434 or cloud endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=optional_ollama_key_if_proxied

# ------------------------------------------------------------------------------
# 2. Audio & Speech Synthesis
# ------------------------------------------------------------------------------
# ElevenLabs API Key (Optional: for Turbo v2.5 low-latency human-like voice synthesis)
# Fallback to local browser WebSpeech API if not provided
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 3. Model & Runtime Settings
# ------------------------------------------------------------------------------
# Default model selection:
# - gemini-2.5-flash (Fast, 0.85s p50 latency, default production model)
# - gemini-2.5-pro   (High reasoning capacity, complex medical/ayurvedic planning)
# - llama-3.3-70b    (via NVIDIA NIM)
YOGASUTRA_MODEL=gemini-2.5-flash

# Logging and Tracing
YOGASUTRA_LOG_LEVEL=INFO
YOGASUTRA_TRACE_DIR=data/traces

# Container & Server Ports
PORT=8000
MCP_PORT=8001
HOST=0.0.0.0

# Security Guardrails & Verification
ENABLE_GUARDRAILS=true
MAX_PRACTICE_DURATION_MINUTES=90
