# YogaSutra Environment Configuration
# Copy this file to .env and fill in your values

# Google AI API Key (required)
# Get your key at: https://aistudio.google.com/apikey
# Refer https://github.com/open-free-llm-api/awesome-freellm-apis
GOOGLE_API_KEY=your_google_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model configuration (Phase 2 default: fast 0.85s model)
YOGASUTRA_MODEL=gemini-3.5-flash-lite

# Tracing
YOGASUTRA_TRACE_DIR=data/traces
YOGASUTRA_LOG_LEVEL=INFO

# Phase 2+ (not required for Phase 1)
# DATABASE_URL=postgresql://user:password@localhost:5432/yogasutra
# PGVECTOR_COLLECTION=yoga_knowledge
