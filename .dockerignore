# ==============================================================================
# .dockerignore — YogaSutra Container Build Exclusions
# ==============================================================================

# Git and version control
.git
.gitignore
.gitattributes

# Python virtual environments & bytecode caches
.venv
venv
env
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Sensitive environment files (NEVER bake secret keys into images)
.env
.env.local
*.pem
*.key

# Temporary artifacts & cache
data/audio_cache/*
!data/audio_cache/.gitkeep
data/traces/*
!data/traces/.gitkeep
data/models/*.task
scratch/
tmp/
